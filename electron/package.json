{
  "name": "outpost-desktop",
  "productName": "Outpost",
  "desktopName": "outpost.desktop",
  "version": "0.3.11",
  "private": true,
  "main": "main.js",
  "homepage": "https://github.com/blindrun/outpost-chat",
  "author": {
    "name": "blindrun",
    "email": "blindrungaming@gmail.com"
  },
  "scripts": {
    "build-web": "node scripts/build-web.js",
    "dev": "npm run build-web && electron .",
    "dist": "npm run build-web && electron-builder --publish never"
  },
  "devDependencies": {
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.outpost-chat.desktop",
    "productName": "Outpost",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "web-dist/**/*"
    ],
    "publish": {
      "provider": "github",
      "owner": "blindrun",
      "repo": "outpost-chat"
    },
    "mac": {
      "icon": "build/icon.png",
      "category": "public.app-category.social-networking",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Network",
      "synopsis": "Self-hosted Discord alternative",
      "syncDesktopName": true,
      "target": [
        "AppImage",
        "deb"
      ]
    }
  },
  "allowScripts": {
    "electron@33.4.11": true
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "overrides": {
    "fast-uri": "^3.1.5"
  }
}
