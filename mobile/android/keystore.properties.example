## Copy to keystore.properties (gitignored) and fill in for a real signed
## release build. CI writes this file itself from repo secrets -- see
## .github/workflows/android.yml -- this template is only for a local
## signed build, which most contributors will never need (an unsigned
## debug APK is enough for local testing).
storeFile=upload-keystore.jks
storePassword=change-me
keyAlias=upload
keyPassword=change-me
