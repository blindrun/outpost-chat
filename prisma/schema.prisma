generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  username     String   @unique
  email        String   @unique
  passwordHash String
  avatarUrl    String?
  // Plain text, app-enforced 240-char cap (no DB-level length constraint,
  // same pattern as CustomCommand.response) — shown on a member's profile
  // card.
  bio          String?
  isOwner      Boolean  @default(false)
  createdAt    DateTime @default(now())

  memberRoles UserRole[]
}

model InstanceSettings {
  id                      String  @id @default("singleton")
  name                    String  @default("Outpost")
  description             String?
  iconUrl                 String?
  theme                   String  @default("business")
  requireInviteToRegister Boolean @default(false)
  defaultChannelId        String?
}

// One-time code an admin reads off the server console (like TeamSpeak's
// ServerAdmin privilege key) and enters in the client to claim ownership
// of a fresh instance — replaces "whoever registers first becomes owner"
// with an explicit, out-of-band-verified handoff. Deleted once consumed.
model ClaimCode {
  id        String   @id @default("singleton")
  code      String
  createdAt DateTime @default(now())
}

model Invite {
  id        String    @id @default(uuid())
  code      String    @unique
  createdBy String
  maxUses   Int?
  uses      Int       @default(0)
  expiresAt DateTime?
  revoked   Boolean   @default(false)
  createdAt DateTime  @default(now())
}

enum ChannelType {
  TEXT
  VOICE
}

model Channel {
  id        String      @id @default(uuid())
  name      String
  type      ChannelType @default(TEXT)
  position  Int         @default(0)
  createdAt DateTime    @default(now())

  messages         Message[]
  webhooks         Webhook[]
  reactionRoles    ReactionRole[]
  reactionRoleMenu ReactionRoleMenu?
}

// A channel-scoped bearer token that lets an external service post messages
// without a real user account — the "bot integration" backlog item, phased
// as webhooks first since they don't need a persistent connection or their
// own auth/permission model, just a channel-scoped secret.
model Webhook {
  id        String   @id @default(uuid())
  channelId String
  channel   Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  name      String
  avatarUrl String?
  token     String   @unique
  createdBy String
  createdAt DateTime @default(now())

  messages Message[]
}

model Message {
  id            String    @id @default(uuid())
  channelId     String
  channel       Channel   @relation(fields: [channelId], references: [id], onDelete: Cascade)
  // At most one of authorId/webhookId is set, and never alongside
  // isSystemBot — a message is sent by a real user (over the gateway), a
  // webhook (over plain REST), or the built-in bot (server-generated),
  // never more than one of the three.
  authorId      String?
  webhookId     String?
  webhook       Webhook?  @relation(fields: [webhookId], references: [id], onDelete: Cascade)
  isSystemBot   Boolean   @default(false)
  content       String
  attachmentUrl String?
  createdAt     DateTime  @default(now())
  editedAt      DateTime?
  pinned        Boolean   @default(false)
  // Replies point at another message in the same channel. SetNull (not
  // Cascade) so deleting the original just drops the quote rather than
  // taking every reply to it down too.
  replyToId String?
  replyTo   Message?  @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies   Message[] @relation("MessageReplies")

  reactions Reaction[]
}

model Reaction {
  id        String   @id @default(uuid())
  messageId String
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  emoji     String
  createdAt DateTime @default(now())

  @@unique([messageId, userId, emoji])
}

model Role {
  id          String   @id @default(uuid())
  name        String
  permissions String[] @default([])
  position    Int      @default(0)

  memberRoles   UserRole[]
  reactionRoles ReactionRole[]
}

// Singleton, same pattern as InstanceSettings — this instance's one built-in
// bot identity (nameable, per the "change the bot's name" ask) plus a toggle
// + config per feature so admins can turn on only what they want.
model BotSettings {
  id        String  @id @default("singleton")
  name      String  @default("Outpost Bot")
  avatarUrl String?

  welcomeEnabled   Boolean @default(false)
  welcomeChannelId String?
  welcomeMessage   String  @default("Welcome to the server, {user}! 👋")

  autoRoleEnabled Boolean @default(false)
  autoRoleId      String?

  customCommandsEnabled Boolean @default(false)

  // Per-channel reaction-role menus are tracked in ReactionRoleMenu, not
  // here — this is just the master on/off switch for the whole feature.
  reactionRolesEnabled Boolean @default(false)

  levelingEnabled  Boolean @default(false)
  levelUpAnnounce  Boolean @default(true)
  levelUpMessage   String  @default("🎉 {user} just reached level {level}!")

  automodEnabled     Boolean  @default(false)
  automodBannedWords String[] @default([])
}

model CustomCommand {
  id        String   @id @default(uuid())
  // Stored without the "!" prefix — matched against a message that's
  // exactly "!<trigger>" (case-insensitive), same convention as classic
  // Discord prefix-command bots.
  trigger   String   @unique
  response  String
  createdAt DateTime @default(now())
}

// One row per configured emoji->role mapping, scoped to a channel. All
// entries for the same channel render together into that channel's one
// standing reaction-role menu message (see ReactionRoleMenu below) — a
// channel can have its own menu, matching the real Carl-bot convention of
// one menu message per channel (not a single instance-wide menu).
model ReactionRole {
  id        String   @id @default(uuid())
  channelId String
  channel   Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  emoji     String
  roleId    String
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([channelId, emoji])
}

// Tracks which message is the standing reaction-role menu for a given
// channel, so refreshing the menu edits that message in place instead of
// reposting every time an entry is added/removed.
model ReactionRoleMenu {
  channelId String  @id
  channel   Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  messageId String
}

model UserLevel {
  userId       String    @id
  xp           Int       @default(0)
  level        Int       @default(0)
  messageCount Int       @default(0)
  // 60s-per-message XP cooldown (matches MEE6/Tatsu convention, prevents
  // spam-leveling) — tracked here rather than in-memory so it survives a
  // server restart.
  lastXpAt     DateTime?
}

model UserRole {
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId String
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}
