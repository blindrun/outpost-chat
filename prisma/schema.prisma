generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  username     String   @unique
  email        String   @unique
  // Null for an account that only ever signs in through an identity
  // provider (see OidcIdentity). Nullable rather than a random unusable
  // hash so every password check has to decide what to do about an SSO
  // account explicitly, instead of silently reporting "wrong password" to
  // someone who has never had one.
  passwordHash String?
  avatarUrl    String?
  // Plain text, app-enforced 240-char cap (no DB-level length constraint,
  // same pattern as CustomCommand.response) — shown on a member's profile
  // card.
  bio          String?
  isOwner      Boolean  @default(false)
  // A developer-created service account (see routes/apiBots.ts) — a real
  // User row with real roles/permissions, distinct from the single
  // built-in server BOT (welcome/leveling/automod, see routes/bot.ts) and
  // from webhooks (one-way, no login). Its "token" is a normal never-
  // expiring JWT minted at creation time and shown once; revocation and
  // deletion both reuse existing User semantics (banned = instantly
  // invalid token, delete = gone) rather than inventing a new mechanism.
  isBot        Boolean  @default(false)
  createdAt    DateTime @default(now())
  // Timed moderation mute — blocks MESSAGE_SEND entirely (unlike automod's
  // per-message banned-word block) until this timestamp passes. Set either
  // manually via POST /moderation/mute or automatically once a user's
  // rolling warning count crosses BotSettings.automodWarnThreshold.
  mutedUntil   DateTime?
  // Permanently blocked from logging in or authenticating at all — unlike
  // a mute (still logged in, just can't send messages), a ban invalidates
  // every already-issued JWT immediately (checked on every authenticated
  // request, not just at login) since tokens here have no expiry.
  banned       Boolean   @default(false)

  // TOTP (Google Authenticator / Authy style). totpSecret is set as soon as
  // setup starts but totpEnabled stays false until the user proves they can
  // generate a valid code with it (POST /mfa/totp/confirm) — an unconfirmed
  // secret just sits there unused if they abandon setup. Stored in plain
  // text (not hashed, unlike passwordHash) because the server has to
  // recompute the expected code from it on every login, same tradeoff every
  // TOTP implementation makes.
  // Base64 SPKI of this user's ECDH P-256 public key, published so other
  // members can encrypt DMs to them. The matching private key is generated on
  // the user's own device and never sent here — the server cannot decrypt
  // anything with this, and its only power is to hand out the wrong key,
  // which is exactly what the client's trust-on-first-use pinning and the
  // per-conversation fingerprint exist to catch.
  //
  // Null means "hasn't set up encryption yet": DMs with that user stay
  // plaintext, with a visible notice, rather than failing to send.
  publicKey   String?

  totpSecret  String?
  totpEnabled Boolean  @default(false)
  // bcrypt-hashed one-time recovery codes, generated alongside TOTP
  // confirmation — each is removed from the array the moment it's used.
  backupCodes String[] @default([])

  memberRoles UserRole[]
  warnings    Warning[]

  dmParticipants      DMParticipant[]
  friendshipsSent     Friendship[]    @relation("FriendshipRequester")
  friendshipsReceived Friendship[]    @relation("FriendshipAddressee")
  webauthnCredentials WebauthnCredential[]
  oidcIdentities      OidcIdentity[]
}

// Links a local account to the subject an identity provider knows it as.
// The (issuer, subject) pair is the identity, never the email: an email
// can be reassigned to a different person at the IdP, `sub` is the one
// claim OIDC guarantees is stable and unique for the life of the account.
// Kept as its own table rather than columns on User so an instance can
// later support several providers without a migration per provider.
model OidcIdentity {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  issuer    String
  subject   String
  createdAt DateTime @default(now())

  @@unique([issuer, subject])
  @@index([userId])
}

// One in-flight authorization request. Holds the CSRF state, the nonce
// that ties the eventual ID token back to this request, and the PKCE
// verifier -- server-side rather than in a cookie because the callback can
// land on a different origin than the one that started it (the desktop app
// and a reverse proxy both do this) and a cookie wouldn't be there.
model OidcAuthRequest {
  id           String   @id @default(uuid())
  state        String   @unique
  nonce        String
  codeVerifier String
  // Both recorded at /start rather than recomputed at /callback. The
  // callback is a top-level navigation, so it arrives with no Origin
  // header at all -- deriving either of these there would quietly produce
  // a different value than the one the authorization request used, and the
  // token endpoint rejects a redirect_uri that doesn't match to the byte.
  redirectUri  String
  returnOrigin String
  // "web" or "native" -- which kind of client started this, and therefore
  // whether the finished sign-in goes back to a URL or to the desktop app's
  // outpost:// handler. Deliberately a two-value flag rather than a return
  // URL supplied by the caller: anything caller-controlled here would be an
  // open redirect carrying a live credential.
  returnTarget String   @default("web")
  createdAt    DateTime @default(now())
  expiresAt    DateTime

  @@index([expiresAt])
}

// A single-use handoff code, swapped by the client for a real session.
// The alternative -- redirecting with the session JWT in the URL -- would
// write a never-expiring credential into browser history, the referrer
// header and any proxy log along the way. Hashed at rest for the same
// reason PasswordResetToken is: a database read alone shouldn't be a login.
model OidcExchangeCode {
  id         String   @id @default(uuid())
  codeHash   String   @unique
  userId     String
  // True when the account has 2FA configured, in which case exchanging
  // this yields an MFA challenge rather than a session -- an IdP's own
  // MFA doesn't stand in for a second factor the user chose to add here.
  mfaPending Boolean  @default(false)
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@index([expiresAt])
}

// A registered security key / platform authenticator (YubiKey, Touch ID,
// Windows Hello, ...) — a user can have several. counter is the
// authenticator's own signature counter, used to detect cloned credentials
// (a real assertion's counter must strictly increase each time).
model WebauthnCredential {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialId String   @unique
  publicKey    Bytes
  counter      Int      @default(0)
  transports   String[] @default([])
  // User-assigned label ("YubiKey 5C", "MacBook Touch ID") shown in the
  // security-key management list — otherwise indistinguishable entries.
  nickname     String
  createdAt    DateTime @default(now())
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
  BLOCKED
}

// One row per unordered pair, regardless of status — app logic always
// queries both directions before creating one, so there's never a
// requester->addressee row *and* an addressee->requester row for the same
// pair. requesterId/addresseeId record who sent the original request (kept
// even after acceptance, for history); blockedById is separate because
// either party can block regardless of who originally requested.
model Friendship {
  id          String           @id @default(uuid())
  requesterId String
  requester   User             @relation("FriendshipRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addresseeId String
  addressee   User             @relation("FriendshipAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)
  status      FriendshipStatus @default(PENDING)
  blockedById String?
  createdAt   DateTime         @default(now())
  respondedAt DateTime?

  @@unique([requesterId, addresseeId])
}

// Join row for a DM channel's two participants — a DM is just a Channel
// with type DM and exactly two of these instead of role-based access.
model DMParticipant {
  channelId String
  channel   Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([channelId, userId])
  // The primary key indexes channelId first, so "which DM channels is this
  // user in" -- which is the lookup the DM list actually makes -- could not
  // use it and scanned instead.
  @@index([userId])
}

// One row per warning (automod-triggered or a moderator's manual !-style
// action via POST /moderation/warn). Kept indefinitely as a history log;
// escalation only counts warnings inside a rolling window (see
// recordWarning in util/bot.ts), not the lifetime total.
model Warning {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  reason      String
  source      String // "automod" | "manual"
  moderatorId String? // null for automod-issued warnings
  createdAt   DateTime @default(now())
}

// Accountability trail for moderation actions (ban/kick/mute/reset-password)
// — before this, none of them left any record of who did what to whom,
// which matters the moment more than one person holds MODERATE_MEMBERS.
// Deliberately no FK/relation to User on either id (unlike Warning, which
// cascade-deletes with its user) — an audit entry is supposed to survive
// the accounts involved being deleted later, same reasoning as
// Message.authorId having no FK (see messages.ts).
model ModerationLogEntry {
  id        String   @id @default(uuid())
  action    String // "ban" | "unban" | "kick" | "voice_kick" | "mute" | "unmute" | "reset_password"
  actorId   String
  targetId  String
  detail    String?
  createdAt DateTime @default(now())
}

enum ReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

// A member-submitted report of a message or another member. Required by App
// Store Guideline 1.2 (any app with user-generated content needs a way for
// users to flag it and for someone to act on the flag), which is also why
// this is a real reviewable queue rather than a fire-and-forget email.
//
// Same no-FK reasoning as ModerationLogEntry above: a report has to outlive
// the accounts and the message involved, since the most common outcome of a
// serious report is exactly that the offender's account or message stops
// existing. messageContent is a snapshot taken at report time for the same
// reason — a moderator opening the queue an hour later still needs to see
// what was actually reported, even if the author deleted it in the meantime.
model Report {
  id             String       @id @default(uuid())
  reporterId     String
  targetUserId   String
  // Set when reporting a specific message; null when reporting a member's
  // conduct generally (from their profile card).
  messageId      String?
  channelId      String?
  messageContent String?
  // True when messageContent came from the reporter's client rather than
  // from the stored row — the only way to report an end-to-end encrypted DM,
  // since the server genuinely cannot read one (see Message.encryptedPayload).
  // Surfaced in the moderator queue as unverified, because it is: a reporter
  // could type anything here. Never set for an ordinary channel message,
  // where the server has the real text.
  contentFromReporter Boolean @default(false)
  // One of the fixed categories in routes/reports.ts — kept a plain string
  // rather than an enum so a self-hoster can add their own without a
  // migration, matching how Warning.source is stored.
  reason         String
  detail         String?
  status         ReportStatus @default(OPEN)
  handledById    String?
  handledAt      DateTime?
  createdAt      DateTime     @default(now())

  // The moderator queue's only real query: open reports, newest first.
  @@index([status, createdAt])
}

model InstanceSettings {
  id                      String  @id @default("singleton")
  name                    String  @default("Outpost")
  description             String?
  iconUrl                 String?
  theme                   String  @default("business")
  requireInviteToRegister Boolean @default(false)
  defaultChannelId        String?
  // Self-hoster-configured outbound SMTP, used only for the self-service
  // "forgot password" email flow (see POST /auth/forgot-password) — off by
  // default, since most self-hosted instances have no mail infra at all and
  // the existing owner-triggered reset-password already covers that case.
  // smtpPassword is plain text (no encryption-at-rest anywhere else in this
  // app either, e.g. Webhook.token/User.totpSecret) — protected by the same
  // DB-access boundary as those.
  smtpEnabled     Boolean @default(false)
  smtpHost        String?
  smtpPort        Int?
  smtpUsername    String?
  smtpPassword    String?
  smtpFromAddress String?
  // Discord-style AFK channel — a member connected to voice who hasn't
  // spoken (per LiveKit's own speaking-detection, already used for the
  // speaking-ring UI) for afkTimeoutMinutes gets auto-moved here. Entirely
  // client-driven (the client that's idle calls the same voice.join() a
  // manual channel switch uses) rather than a server-side timer, since only
  // the client actually knows its own speaking history — LiveKit audio
  // activity isn't visible server-side at all. Off unless both fields are
  // set.
  afkChannelId      String?
  afkTimeoutMinutes Int?
}

// A single-use, short-lived token for the self-service "forgot password"
// email flow. tokenHash (not the raw token) is stored — same reasoning as
// User.passwordHash: this is a bearer credential mailed to the user, so a DB
// read alone shouldn't be enough to take over the account. Deleted once
// consumed rather than flagged, so an expired/used token can't accumulate
// forever; no formal relation to User (this app's other loose-FK models,
// e.g. Invite.createdBy, follow the same plain-string-id pattern).
model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// Per-user, per-channel "I've seen everything up to here" marker — covers
// both regular channels and DMs, since both are rows in the same Channel
// table. Written by POST /channels/:channelId/read (fired on the same
// "opening a channel is what reads it" moment the client already had
// purely client-side), read by the gateway at READY time to seed unread
// state that survives a reload/new session instead of resetting to empty
// every time, which is what happened before this existed. No row for a
// given (userId, channelId) means "never explicitly read" — treated as
// caught-up rather than retroactively unread, so this doesn't flag every
// pre-existing channel unread the moment it ships.
model ChannelReadState {
  userId     String
  channelId  String
  lastReadAt DateTime @default(now())

  @@id([userId, channelId])
}

// One-time code an admin reads off the server console (like TeamSpeak's
// ServerAdmin privilege key) and enters in the client to claim ownership
// of a fresh instance — replaces "whoever registers first becomes owner"
// with an explicit, out-of-band-verified handoff. Deleted once consumed.
model ClaimCode {
  id        String   @id @default("singleton")
  code      String
  createdAt DateTime @default(now())
}

model Invite {
  id        String    @id @default(uuid())
  code      String    @unique
  createdBy String
  maxUses   Int?
  uses      Int       @default(0)
  expiresAt DateTime?
  revoked   Boolean   @default(false)
  createdAt DateTime  @default(now())
}

enum ChannelType {
  TEXT
  VOICE
  THREAD
  DM
}

model Channel {
  id        String      @id @default(uuid())
  name      String
  type      ChannelType @default(TEXT)
  position  Int         @default(0)
  createdAt DateTime    @default(now())
  // THREAD channels only — which channel/message they branched off of.
  // Denormalized (parentChannelId duplicates parentMessage.channelId)
  // so opening a thread doesn't need an extra join back through Message.
  parentChannelId String?
  parentMessageId String? @unique
  // Empty = visible to everyone (today's behavior, and every channel's
  // default). Non-empty = hidden from anyone without at least one of these
  // roles, checked both when the channel list is built (REST/READY) and on
  // every gateway event scoped to this channel, so a restricted channel's
  // messages never reach a socket that can't see it either. A THREAD
  // inherits its parent channel's value at creation time (no separate UI
  // to restrict a thread on its own).
  restrictedToRoleIds String[] @default([])

  messages         Message[]
  webhooks         Webhook[]
  reactionRoles    ReactionRole[]
  reactionRoleMenu ReactionRoleMenu?
  parentMessage    Message?           @relation("MessageThread", fields: [parentMessageId], references: [id])
  dmParticipants   DMParticipant[]
}

// A channel-scoped bearer token that lets an external service post messages
// without a real user account — the "bot integration" backlog item, phased
// as webhooks first since they don't need a persistent connection or their
// own auth/permission model, just a channel-scoped secret.
model Webhook {
  id        String   @id @default(uuid())
  channelId String
  channel   Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  name      String
  avatarUrl String?
  token     String   @unique
  createdBy String
  createdAt DateTime @default(now())

  messages Message[]
}

model Message {
  id            String    @id @default(uuid())
  channelId     String
  channel       Channel   @relation(fields: [channelId], references: [id], onDelete: Cascade)
  // At most one of authorId/webhookId is set, and never alongside
  // isSystemBot — a message is sent by a real user (over the gateway), a
  // webhook (over plain REST), or the built-in bot (server-generated),
  // never more than one of the three.
  authorId      String?
  webhookId     String?
  webhook       Webhook?  @relation(fields: [webhookId], references: [id], onDelete: Cascade)
  isSystemBot   Boolean   @default(false)
  // Plaintext body. Empty string when encryptedPayload is set — the two are
  // mutually exclusive, and `content` stays non-null so every existing query,
  // serializer and index keeps working untouched.
  content       String
  // End-to-end encrypted body: the JSON envelope from web/src/crypto/keys.ts
  // ({v, iv, ct}), opaque here. DM channels only, and only when both
  // participants have published a public key. The server cannot read this and
  // has no key to read it with — it stores and forwards it, nothing more.
  //
  // Version lives in its own column rather than only inside the JSON so a
  // future scheme can be found and migrated with a query instead of parsing
  // every row.
  encryptedPayload  String?
  encryptionVersion Int?
  attachmentUrl String?
  // Per-send persona override for a webhook message (Discord/Slack
  // convention — one webhook, many personas). Stored per-message rather than
  // read live off Webhook, so a name/avatar reload after the fact reflects
  // what was actually sent, not the webhook's current defaults.
  overrideUsername  String?
  overrideAvatarUrl String?
  createdAt     DateTime  @default(now())
  editedAt      DateTime?
  pinned        Boolean   @default(false)
  // Replies point at another message in the same channel. SetNull (not
  // Cascade) so deleting the original just drops the quote rather than
  // taking every reply to it down too.
  replyToId String?
  replyTo   Message?  @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies   Message[] @relation("MessageReplies")

  // Reverse side of Channel.parentMessageId — at most one thread per
  // message, matching Discord's "start a thread from this message".
  thread Channel? @relation("MessageThread")

  reactions Reaction[]

  // Every channel view is "this channel's messages, newest first", and
  // there was no index for it at all -- Postgres scanned the whole table
  // and sorted. Composite and in this order so the same index serves both
  // the filter and the ordering.
  @@index([channelId, createdAt])
}

model Reaction {
  id        String   @id @default(uuid())
  messageId String
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  emoji     String
  createdAt DateTime @default(now())

  @@unique([messageId, userId, emoji])
}

model Role {
  id          String   @id @default(uuid())
  name        String
  permissions String[] @default([])
  position    Int      @default(0)

  memberRoles   UserRole[]
  reactionRoles ReactionRole[]
}

// Singleton, same pattern as InstanceSettings — this instance's one built-in
// bot identity (nameable, per the "change the bot's name" ask) plus a toggle
// + config per feature so admins can turn on only what they want.
model BotSettings {
  id        String  @id @default("singleton")
  name      String  @default("Outpost Bot")
  avatarUrl String?

  welcomeEnabled   Boolean @default(false)
  welcomeChannelId String?
  welcomeMessage   String  @default("Welcome to the server, {user}! 👋")

  autoRoleEnabled Boolean @default(false)
  autoRoleId      String?

  customCommandsEnabled Boolean @default(false)

  // Per-channel reaction-role menus are tracked in ReactionRoleMenu, not
  // here — this is just the master on/off switch for the whole feature.
  reactionRolesEnabled Boolean @default(false)

  levelingEnabled  Boolean @default(false)
  levelUpAnnounce  Boolean @default(true)
  levelUpMessage   String  @default("🎉 {user} just reached level {level}!")

  automodEnabled     Boolean  @default(false)
  automodBannedWords String[] @default([])
  // Escalation beyond delete-on-match: automodWarnThreshold warnings inside
  // a rolling 24h window auto-mutes the user for automodMuteMinutes.
  automodWarnThreshold Int @default(3)
  automodMuteMinutes   Int @default(10)
}

model CustomCommand {
  id        String   @id @default(uuid())
  // Stored without the "!" prefix — matched against a message that's
  // exactly "!<trigger>" (case-insensitive), same convention as classic
  // Discord prefix-command bots.
  trigger   String   @unique
  response  String
  createdAt DateTime @default(now())
}

// One row per configured emoji->role mapping, scoped to a channel. All
// entries for the same channel render together into that channel's one
// standing reaction-role menu message (see ReactionRoleMenu below) — a
// channel can have its own menu, matching the real Carl-bot convention of
// one menu message per channel (not a single instance-wide menu).
model ReactionRole {
  id        String   @id @default(uuid())
  channelId String
  channel   Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  emoji     String
  roleId    String
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([channelId, emoji])
}

// Tracks which message is the standing reaction-role menu for a given
// channel, so refreshing the menu edits that message in place instead of
// reposting every time an entry is added/removed.
model ReactionRoleMenu {
  channelId String  @id
  channel   Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  messageId String
}

model UserLevel {
  userId       String    @id
  xp           Int       @default(0)
  level        Int       @default(0)
  messageCount Int       @default(0)
  // 60s-per-message XP cooldown (matches MEE6/Tatsu convention, prevents
  // spam-leveling) — tracked here rather than in-memory so it survives a
  // server restart.
  lastXpAt     DateTime?
}

model UserRole {
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId String
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

// A server-uploaded emoji, usable in message text as :name: (see
// renderInline in MessageItem.tsx) — not usable as a message *reaction* in
// this version, unlike Discord's; reactions have their own short-string
// constraint and render as plain text, not an image, so supporting custom
// emoji there is a separate, bigger change. name is stored lowercased and
// unique so :Party: and :party: can't both exist as confusingly-different
// emoji.
model CustomEmoji {
  id        String   @id @default(uuid())
  name      String   @unique
  imageUrl  String
  createdBy String
  createdAt DateTime @default(now())
}
