# Copy this to .env and fill it in — or just run ./install.sh, which does
# this for you (generates every secret below, and prompts for the two
# PUBLIC_HOST-derived values).

# The Docker image to run — defaults to the official pre-built image.
# Point this at a locally-built image instead if you want to build from
# source (see README).
APP_IMAGE=ghcr.io/blindrun/outpost-chat:latest

# Port the app (web UI + API) is exposed on.
APP_PORT=8080

# Random secrets — install.sh generates these for you. If filling in by
# hand, use something like `openssl rand -hex 32`.
JWT_SECRET=
POSTGRES_PASSWORD=
MINIO_ROOT_USER=outpost
MINIO_ROOT_PASSWORD=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Must be reachable from every client's machine (browsers AND the desktop
# app), not just from inside this Docker network — set these to your
# server's real public IP or domain. install.sh derives these from the host
# you give it (and from whether you said yes to the HTTPS reverse-proxy
# prompt — see README.md's TLS section for why that matters: browsers
# silently break avatar/attachment images and outright refuse the voice
# websocket if these point at plain http/ws while the app itself is https).
#
# Behind an HTTPS reverse proxy (recommended, required for voice):
#   LIVEKIT_URL=wss://YOUR_SERVER_HOST
#   MINIO_PUBLIC_URL=https://YOUR_SERVER_HOST/outpost-uploads
# Plain HTTP, e.g. LAN-only testing (voice chat will not work):
#   LIVEKIT_URL=ws://YOUR_SERVER_HOST:7880
#   MINIO_PUBLIC_URL=http://YOUR_SERVER_HOST:9000/outpost-uploads
LIVEKIT_URL=ws://YOUR_SERVER_HOST:7880
MINIO_PUBLIC_URL=http://YOUR_SERVER_HOST:9000/outpost-uploads

# Leave blank to allow any origin (fine for a bearer-JWT API; see
# src/server.ts). Set to a comma-separated list to restrict it.
CORS_ORIGIN=

# Optional. Get a free key at https://developers.giphy.com/ — without it,
# the in-app GIF picker button just doesn't show up (not a broken feature,
# a hidden one). Leave blank to skip.
GIPHY_API_KEY=
