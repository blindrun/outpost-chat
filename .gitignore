node_modules/
dist/
web/dist/
.env
deploy/.env
deploy/livekit.yaml
electron/web-dist/
electron/release/
mobile/web-dist/
mobile/android/app/release/
# Real signing keystore + its passwords -- never committed, CI writes
# these from repo secrets at build time (see .github/workflows/android.yml).
mobile/android/keystore.properties
mobile/android/*.jks
mobile/android/*.keystore

# Local convenience: the server serves the built client from here, which
# the Docker image populates at build time. A symlink to web/dist locally.
/web-dist

# App Store review demo credentials. This repo is public, so the reviewer
# account's username and password must never be committed. Create these two
# files locally right before running `fastlane deliver`, or supply them from
# CI secrets. Everything else under fastlane/metadata is safe to publish.
mobile/ios/fastlane/metadata/review_information/demo_user.txt
mobile/ios/fastlane/metadata/review_information/demo_password.txt
