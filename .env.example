# Local dev only — matches the dev docker-compose.yml at the repo root
# (Postgres on 5433, MinIO on 9000/9001, LiveKit in --dev mode with its
# well-known devkey/secret). Copy to .env. For self-hosting a real
# instance, use deploy/ instead — this file is not that.

DATABASE_URL=postgresql://discord_clone:devpassword@localhost:5433/discord_clone
JWT_SECRET=insecure-dev-secret
PORT=8080

# LiveKit's own documented --dev mode default — fine for local dev only,
# never use this pair for a real deployment.
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
LIVEKIT_URL=ws://localhost:7880

MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=discord_clone
MINIO_SECRET_KEY=devpassword123
MINIO_BUCKET=discord-clone-uploads
MINIO_PUBLIC_URL=http://localhost:9000/discord-clone-uploads
